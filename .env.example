# Postgres (docker compose sobe na porta 5433)
DATABASE_URL=postgres://nexo:nexo@localhost:5433/nexo

# LLM — custo zero. Opções:
#   google/gemini-flash-latest → chave gratuita em https://aistudio.google.com/apikey
#   ollama/qwen3:8b          → modelo local (https://ollama.com), sem chave
LLM_MODEL=google/gemini-flash-latest
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/api
# Limite de chamadas ao LLM por dia (protege o tier gratuito)
LLM_DAILY_BUDGET=500

# Sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# Serviço de chamados simulado
TICKETS_SERVICE_URL=http://localhost:4001
TICKETS_SERVICE_TOKEN=dev-service-token
TICKETS_SERVICE_PORT=4001
# Instabilidade simulada do sistema legado
CHAOS_FAILURE_RATE=0.15
CHAOS_LATENCY_MS=300
